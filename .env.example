# Cricket 2026 Environment Configuration Guide

# ==============================================================
# 1. Vercel (Web Client Frontend) Environment Variables
# ==============================================================
# Set this in your Vercel Project Settings -> Environment Variables:
# Points the client browser to your deployed Render server URL:
VITE_SERVER_URL=https://cricket2026-authoritative-server.onrender.com

# ==============================================================
# 2. Render (Authoritative Game Server) Environment Variables
# ==============================================================
# The following are configured automatically by render.yaml:
NODE_ENV=production
CORS_ORIGIN=*
TICK_RATE_HZ=30
DEFAULT_OVERS=5
RECONNECT_GRACE_MS=30000
MAX_ROOMS=100
# Note: Do NOT set PORT manually on Render; Render injects PORT dynamically.

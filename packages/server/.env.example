# Cricket 2026 Authoritative Game Server Environment Configuration
PORT=4000
NODE_ENV=production

# CORS allowed origins (comma-separated for multiple origins, or * for open access)
CORS_ORIGIN=https://cricket2026.vercel.app,http://localhost:5173

# Authoritative simulation tick rate in Hertz (default: 30)
TICK_RATE_HZ=30

# Match length in overs per innings (default: 5)
DEFAULT_OVERS=5

# Disconnection grace window in milliseconds before player slot purge (default: 30000)
RECONNECT_GRACE_MS=30000

# Maximum concurrent game rooms allowed (default: 100)
MAX_ROOMS=100

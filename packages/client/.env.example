# Cricket 2026 Web Client Environment Configuration

# URL of the persistent Node.js authoritative game server
# For local development with Vite dev server proxy: leave empty or http://localhost:4000
# For production deployment on Vercel: set to your deployed backend URL, e.g. https://cricket2026-server.onrender.com
VITE_SERVER_URL=https://cricket2026-server.onrender.com

{
  "name": "cricket-2026-root",
  "version": "0.1.0",
  "private": true,
  "description": "Production-quality realistic 3D multiplayer cricket browser game",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "dev:server": "npm run dev -w @cricket2026/server",
    "dev:client": "npm run dev -w @cricket2026/client"
  },
  "devDependencies": {
    "@types/node": "^20.17.10",
    "typescript": "^5.7.3"
  }
}
